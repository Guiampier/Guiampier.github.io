<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visualizador de Colores Minecraft</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #1a1a1a;
            color: white;
            padding: 20px;
            max-width: 1000px;
            margin: 0 auto;
        }
        h1 {
            color: #55FF55;
            text-align: center;
            margin-bottom: 30px;
        }
        .container {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }
        .input-section, .output-section {
            flex: 1;
            min-width: 300px;
        }
        textarea {
            width: 100%;
            padding: 15px;
            background-color: #2d2d2d;
            color: white;
            border: 2px solid #555;
            border-radius: 8px;
            font-family: monospace;
            min-height: 150px;
            font-size: 16px;
            margin-bottom: 20px;
        }
        .color-display {
            background-color: #252525;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            font-size: 28px;
            font-weight: bold;
            min-height: 60px;
            word-break: break-all;
        }
        .letter-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 20px;
        }
        .letter-box {
            background-color: #1e1e1e;
            border-radius: 5px;
            padding: 10px;
            text-align: center;
            min-width: 60px;
        }
        .letter {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .color-preview {
            width: 40px;
            height: 20px;
            margin: 0 auto 5px;
            border: 1px solid #444;
        }
        .color-code {
            font-family: monospace;
            font-size: 12px;
            color: #aaa;
        }
        .controls {
            margin: 20px 0;
            text-align: center;
        }
        button {
            background-color: #4CAF50;
            color: white;
            border: none;
            padding: 10px 20px;
            margin: 0 10px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
        button:hover {
            background-color: #45a049;
        }
    </style>
</head>
<body>
    <h1>Visualizador de Colores Minecraft</h1>
    
    <div class="container">
        <div class="input-section">
            <h2>Introduce tu código:</h2>
            <textarea id="minecraftCode" placeholder="Ejemplo: &#FFD700&lDorado o &c&lRojo">&#0CD7FB&lP&#3DBFF2&lW&#6DA7E9&lA&#9E8EDF&lR&#CE76D6&lP &#FF5ECD&lM&#E74CD6&la&#CE3ADE&lp&#B627E7&la&#9D15EF&lr&#8503F8&lt</textarea>
            <div class="controls">
                <button onclick="processCode()">Mostrar Colores</button>
                <button onclick="copyCode()">Copiar Código</button>
                <button onclick="resetAll()">Resetear</button>
            </div>
        </div>
        
        <div class="output-section">
            <h2>Resultado:</h2>
            <div class="color-display" id="colorResult"></div>
            
            <h2>Desglose por letra:</h2>
            <div class="letter-grid" id="letterGrid"></div>
        </div>
    </div>

    <script>
        function processCode() {
            const code = document.getElementById('minecraftCode').value;
            const resultDiv = document.getElementById('colorResult');
            const letterGrid = document.getElementById('letterGrid');
            
            // Limpiar resultados anteriores
            resultDiv.innerHTML = '';
            letterGrid.innerHTML = '';
            
            let currentColor = '#FFFFFF';
            let isBold = false;
            let lettersProcessed = 0;
            
            // Función para añadir una letra al grid
            function addLetterToGrid(char, color) {
                if (char.trim() === '') return;
                
                const letterBox = document.createElement('div');
                letterBox.className = 'letter-box';
                
                letterBox.innerHTML = `
                    <div class="color-preview" style="background-color: ${color};"></div>
                    <div class="letter" style="color: ${color}; font-weight: ${isBold ? 'bold' : 'normal'}">${char}</div>
                    <div class="color-code">${color}</div>
                `;
                
                letterGrid.appendChild(letterBox);
                lettersProcessed++;
            }
            
            // Procesar el código
            let i = 0;
            while (i < code.length) {
                if (code[i] === '&' || code[i] === '§') {
                    // Encontramos un código de formato
                    const formatChar = code[i];
                    i++;
                    
                    if (code[i] === '#') {
                        // Código HEX (&#RRGGBB)
                        const hexColor = code.substring(i+1, i+7);
                        if (/^[0-9A-Fa-f]{6}$/.test(hexColor)) {
                            currentColor = `#${hexColor}`;
                            i += 7;
                        }
                    } else {
                        // Código clásico (&a, &l, etc.)
                        const formatCode = code[i].toLowerCase();
                        switch (formatCode) {
                            case '0': currentColor = '#000000'; break;
                            case '1': currentColor = '#0000AA'; break;
                            case '2': currentColor = '#00AA00'; break;
                            case '3': currentColor = '#00AAAA'; break;
                            case '4': currentColor = '#AA0000'; break;
                            case '5': currentColor = '#AA00AA'; break;
                            case '6': currentColor = '#FFAA00'; break;
                            case '7': currentColor = '#AAAAAA'; break;
                            case '8': currentColor = '#555555'; break;
                            case '9': currentColor = '#5555FF'; break;
                            case 'a': currentColor = '#55FF55'; break;
                            case 'b': currentColor = '#55FFFF'; break;
                            case 'c': currentColor = '#FF5555'; break;
                            case 'd': currentColor = '#FF55FF'; break;
                            case 'e': currentColor = '#FFFF55'; break;
                            case 'f': currentColor = '#FFFFFF'; break;
                            case 'l': isBold = true; break;
                            case 'r': 
                                currentColor = '#FFFFFF';
                                isBold = false;
                                break;
                        }
                        i++;
                    }
                } else {
                    // Es un carácter normal
                    const char = code[i];
                    
                    // Añadir al resultado principal
                    const span = document.createElement('span');
                    span.style.color = currentColor;
                    if (isBold) span.style.fontWeight = 'bold';
                    span.textContent = char;
                    resultDiv.appendChild(span);
                    
                    // Añadir al grid de letras
                    addLetterToGrid(char, currentColor);
                    
                    i++;
                }
            }
            
            // Si no se procesaron letras (solo códigos)
            if (lettersProcessed === 0) {
                letterGrid.innerHTML = '<p>No se encontraron letras para mostrar</p>';
            }
        }
        
        function copyCode() {
            const code = document.getElementById('minecraftCode');
            code.select();
            document.execCommand('copy');
            alert('Código copiado al portapapeles!');
        }
        
        function resetAll() {
            document.getElementById('minecraftCode').value = '';
            document.getElementById('colorResult').innerHTML = '';
            document.getElementById('letterGrid').innerHTML = '';
        }
        
        // Procesar automáticamente al cargar
        window.onload = processCode;
    </script>
</body>
</html>
